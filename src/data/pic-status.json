{
  "picProcedureSteps": [
    {
      "step": 1,
      "title": "Confirm classification and States concerned",
      "detail": "Confirm whether the material is waste, its current Basel entry, and every State of export, import and planned transit. For e-waste, use A1181/Y49 where applicable and check current OECD/national controls."
    },
    {
      "step": 2,
      "title": "File through the competent authority of export",
      "detail": "Submit the required notification package through the State of export in accordance with Article 6 and applicable national procedures."
    },
    {
      "step": 3,
      "title": "Authorities of import and transit review",
      "detail": "The State of import and each relevant State of transit apply the consent, objection or waiver rules that actually govern that route. Do not assume one universal OECD consent procedure."
    },
    {
      "step": 4,
      "title": "Record the required consents or lawful waivers",
      "detail": "Do not move until the required written consents, applicable lawful tacit-consent conditions, or transit waivers are established for the specific route."
    },
    {
      "step": 5,
      "title": "Verify conditions immediately before movement",
      "detail": "Confirm consent validity, national conditions, route, carrier and movement-document requirements before shipment. Re-check any authority contact or rule that may have changed."
    }
  ],
