  "complianceSteps": {
    "banned": [
      "Shipment is PROHIBITED under Basel Ban Amendment \u2014 do not proceed",
      "Confirm classification: is the waste truly hazardous? If B1110 applies (tested-working), ban may not apply",
      "Explore alternative destination countries in Annex VII (OECD/EU)",
      "Consult a Basel compliance specialist before any further action"
    ],
    "high": [
      "Obtain waste characterization and hazardous constituent analysis",
      "Apply to your national Competent Authority for notification approval",
      "Submit formal PIC request to destination CA and await written consent",
      "Arrange transit country consents if routing through non-Basel-party states",
      "Prepare financial guarantee / environmental insurance",
      "Complete Basel notification document with all supporting documentation",
      "Ensure carrier is licensed for transboundary hazardous waste movement",
      "Retain all consent letters \u2014 movement documents must accompany waste"
    ],
    "medium": [
      "Confirm waste classification \u2014 verify Basel code and hazard status",
      "Notify your national Competent Authority of intended transboundary movement",
      "Obtain Prior Informed Consent from destination CA (written)",
      "Prepare Basel notification document and movement documents",
      "Ensure financial guarantee is in place before shipment",
      "Carrier must hold appropriate transboundary waste transport authorization"
    ],
    "low": [
      "Confirm waste code and hazard status for customs documentation",
      "Notify your national CA per OECD Decision C(2001)107 if required",
      "Allow 30-day tacit consent period for OECD-to-OECD shipments",
      "Maintain movement documents with waste throughout journey",
      "Ensure receiving facility holds appropriate recovery/reuse authorization"
    ]
  },
  "transitWarnings": {
    "Caribbean-to-Europe": "Caribbean routes to Europe typically transit through US ports. The US is not a Basel party \u2014 US port transit does not constitute Basel export to the US, but carrier must ensure no deconsolidation or storage in US territory.",
    "Caribbean-to-Asia": "Caribbean to Asia routes commonly transit through Panama Canal. Panama is a Basel party. If waste is offloaded or stored in transit, PIC from Panama CA is required.",
    "WestAfrica-to-Europe": "Direct West Africa to Western Europe routes available via major shipping lines. Transit through North African ports (Morocco, Egypt) may require additional CAs if cargo is transshipped.",
    "Asia-to-Europe": "Asia to Europe commonly transits Suez Canal / Egyptian ports. If waste is offloaded in Egypt, Egyptian CA consent is required.",
    "default": "Verify your shipping route with your freight forwarder. If cargo is offloaded or stored in any transit country, Prior Informed Consent from that country's CA is required under Article 6."
  }
